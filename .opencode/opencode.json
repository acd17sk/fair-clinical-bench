{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/kimi-k2.6",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode/kimi-k2.6",
      "thinking": { "type": "enabled", "keep": "all" },
      "prompt": "{default}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "question": "allow"
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode/kimi-k2.6",
      "thinking": { "type": "enabled", "keep": "all" },
      "prompt": "{default}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "test_engineer": {
      "permissions": [
        { "permission": "read", "action": "allow", "pattern": "*" },
        { "permission": "edit", "action": "allow", "pattern": "*" },
        { "permission": "bash", "action": "allow", "pattern": "*" }
      ]
    }
  }
}
